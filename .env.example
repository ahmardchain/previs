# Walrus Memory (required for the hackathon: writes must land on Mainnet)
# Get both from the Walrus Memory dashboard / playground (memory.walrus.xyz).
MEMWAL_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE=previs

# Tatum (Sui Mainnet gateway, GraphQL — Sui deprecated JSON-RPC) — free Mainnet key at dashboard.tatum.io
TATUM_API_KEY=
TATUM_SUI_GRAPHQL=https://sui-mainnet.gateway.tatum.io/graphql

# Optional: lets Claude phrase copilot answers more naturally (numbers never come from the model)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: protect the demo "settle a market" endpoint
PREVIS_ADMIN_KEY=
